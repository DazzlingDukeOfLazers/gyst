  .story-stage.has-day-focus [data-day-index].is-focused { opacity: 1; filter: none; }
  .event-card.is-focused, .failure-card.is-focused { box-shadow: 0 0 0 4px var(--acid), 8px 8px 0 var(--blue); }

  .track-controls { margin-top: 42px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border: 1px solid #69675f; background: #242421; }
  .track-controls p { margin: 0; display: flex; align-items: baseline; gap: 12px; }
  .track-controls p strong { color: var(--acid); font: 800 11px/1.2 ui-monospace, monospace; letter-spacing: .08em; }
  .track-controls p span, .track-controls > div > span { color: #aaa79e; font: 650 10px/1.2 ui-monospace, monospace; }
  .track-controls > div { display: flex; align-items: center; gap: 10px; }
  .track-controls button { width: 42px; height: 38px; border: 1.5px solid white; color: white; background: var(--ink); cursor: pointer; font: 900 19px/1 ui-monospace, monospace; }
  .track-controls button:hover { color: var(--ink); background: var(--acid); }
  .event-window { position: relative; }
  .event-window::after { content: "MORE →"; position: absolute; z-index: 4; top: 18px; right: -1px; bottom: 30px; width: 74px; display: grid; place-items: center; pointer-events: none; color: var(--acid); background: linear-gradient(90deg, transparent, var(--ink) 72%); font: 800 9px/1 ui-monospace, monospace; writing-mode: vertical-rl; letter-spacing: .12em; }
  .event-track { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(330px, 34vw, 430px); align-items: start; gap: 18px; padding: 26px 78px 28px 2px; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: inline mandatory; scrollbar-color: var(--orange) #33332f; }
  .event-card { min-height: 0; align-self: start; display: grid; grid-template-rows: auto auto auto; color: var(--ink); background: var(--paper-bright); border: var(--rule); scroll-snap-align: start; }
  .event-card.alice { border-top: 12px solid var(--acid); }
  .event-card.bob { border-top: 12px solid var(--orange); }
  .event-card.charlie { border-top: 12px solid var(--blue); }
  .event-card.gyst { border-top: 12px solid white; }
  .event-meta { padding: 14px 16px; display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 10px; border-bottom: var(--rule); }
  .event-meta p { margin: 0; display: grid; gap: 3px; }
  .event-meta p strong { font-size: 14px; }
  .event-meta p span, .event-day, .event-number, .event-cost span { color: var(--muted); font: 700 10px/1.2 ui-monospace, monospace; text-transform: uppercase; }
  .event-day { color: var(--blue); }
  .event-copy { padding: 18px 19px 20px; display: grid; grid-template-columns: 62px 1fr; column-gap: 16px; align-items: start; }
  .event-icon { width: 62px; height: 62px; padding: 9px; display: grid; place-items: center; border: var(--rule); background: var(--acid); }
  .event-icon img { width: 100%; height: 100%; object-fit: contain; }
  .bob .event-icon { background: var(--orange); }
  .charlie .event-icon { background: var(--blue); }
  .charlie .event-icon img { filter: invert(1); }
  .gyst .event-icon { background: white; }
  .event-icon { grid-row: 1 / span 2; }
  .event-number { grid-column: 2; margin: 1px 0 7px; }
  .event-copy h3 { grid-column: 2; margin-bottom: 12px; font-size: clamp(24px, 2vw, 29px); line-height: 1; letter-spacing: -.045em; }
  .event-copy > p:not(.event-number) { grid-column: 1 / -1; margin-top: 12px; color: var(--muted); font-size: 16px; line-height: 1.45; }
  .event-copy ul { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 7px; padding: 0; margin: 16px 0 0; list-style: none; }
  .event-copy li { padding: 7px 8px; border: 1.5px solid var(--ink); background: var(--paper); font: 700 10px/1 ui-monospace, monospace; text-transform: uppercase; }
  .event-cost { padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: var(--rule); }
  .event-cost strong { color: var(--blue); font-size: 26px; letter-spacing: -.04em; }
  .story-note { max-width: 900px; margin: 20px 0 0; color: #aaa79e; font: 600 11px/1.55 ui-monospace, monospace; }

  .story-stage[data-story-layout="vertical"] .track-controls { display: none; }
  .story-stage[data-story-layout="vertical"] .event-window::after { display: none; }
