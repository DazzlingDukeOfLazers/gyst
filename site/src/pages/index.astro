  .versus { margin-top: clamp(84px, 10vw, 150px); padding-top: clamp(70px, 8vw, 120px); border-top: 2px solid #69675f; }
  .versus-heading { display: grid; grid-template-columns: .42fr 1.05fr .72fr; align-items: start; gap: clamp(28px, 5vw, 80px); }
  .versus-heading h3 { margin: 0; font-size: clamp(46px, 6vw, 86px); line-height: .9; letter-spacing: -.06em; }
  .versus-heading h3 span { color: var(--orange); }
  .versus-heading > p:last-child { color: #c8c5bd; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.48; }
  .versus-scoreboard { max-width: 980px; margin: 64px auto 36px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; }
  .score { padding: clamp(22px, 4vw, 44px); color: var(--ink); border: 2px solid white; }
