  .team-network { margin: 0 clamp(20px, 4vw, 64px) clamp(72px, 8vw, 112px); padding: clamp(24px, 3.5vw, 48px); display: grid; grid-template-columns: minmax(360px, 1.35fr) auto minmax(150px, .55fr) auto minmax(130px, .42fr) auto minmax(150px, .5fr); align-items: center; gap: 18px; border: var(--rule); background: var(--paper-bright); box-shadow: 10px 10px 0 var(--ink); }
