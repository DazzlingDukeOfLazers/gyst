  .comparison-row i { min-height: 25px; margin: 2px 0; border: 1px solid #44433f; background: #161614; }
  .evidence-row i.active { background: var(--blue); border-color: white; }
  .evidence-row i.result { background: var(--acid); box-shadow: inset 0 0 0 4px var(--blue); }
  .wrong-row i.active { background: var(--orange); border-color: white; }
  .wrong-row i.chaos { background: repeating-linear-gradient(135deg, var(--orange) 0 7px, #8f260e 7px 14px); }
  .beyond-window { min-width: 870px; margin: 10px 0 0 110px; color: var(--orange); font: 800 10px/1.3 ui-monospace, monospace; text-align: right; }
  .failure-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); align-items: start; gap: 14px; margin-top: 34px; }
  .failure-card { align-self: start; padding: 20px; color: var(--ink); border: 2px solid white; background: var(--paper-bright); }
  .failure-card > div { display: flex; justify-content: space-between; gap: 12px; color: var(--orange); font: 800 10px/1.2 ui-monospace, monospace; text-transform: uppercase; }
  .failure-card h4 { margin: 24px 0 10px; font-size: 24px; line-height: 1; letter-spacing: -.04em; }
  .failure-card p { min-height: 0; margin-bottom: 20px; color: var(--muted); font-size: 16px; line-height: 1.45; }
  .failure-card > span { display: inline-block; padding: 7px 9px; color: white; background: var(--orange); font: 850 11px/1 ui-monospace, monospace; }
  .cost-consequence { margin-top: 34px; display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); padding: clamp(28px, 5vw, 64px); border: 2px solid var(--orange); background: #20120e; }
  .cost-delta { display: block; margin: 12px 0; color: var(--orange); font-size: clamp(64px, 9vw, 132px); line-height: .8; letter-spacing: -.07em; }
  .cost-consequence > div > p:last-child { max-width: 520px; color: #c8c5bd; font-size: 17px; line-height: 1.45; }
  .cost-consequence ul { margin: 0; padding: 0; list-style: none; }
  .cost-consequence li { padding: 14px 0; display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid #6d3930; font-size: 16px; }
  .cost-consequence li strong { color: var(--orange); }

  .quickstart { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(48px, 8vw, 120px); background: var(--acid); }
  .quickstart-copy ol { padding: 0; margin: 38px 0 0; list-style: none; }
  .quickstart-copy li { display: flex; align-items: flex-start; gap: 16px; padding: 18px 0; border-top: 1.5px solid var(--ink); }
  .quickstart-copy li:last-child { border-bottom: 1.5px solid var(--ink); }
  .quickstart-copy li > span { display: grid; place-items: center; flex: 0 0 30px; height: 30px; color: white; background: var(--ink); border-radius: 50%; font: 800 12px/1 monospace; }
  .quickstart-copy li div { display: grid; grid-template-columns: 95px 1fr; gap: 16px; width: 100%; }
  .quickstart-copy li strong { font: 850 13px/1.4 ui-monospace, monospace; text-transform: uppercase; }
  .quickstart-copy li p { margin: 0; line-height: 1.4; }
  .terminal { align-self: center; border: var(--rule); background: var(--ink); color: #f7f3e8; box-shadow: 10px 10px 0 color-mix(in srgb, var(--blue) 100%, black); overflow: hidden; }
  .terminal-bar { display: flex; justify-content: space-between; gap: 20px; padding: 13px 16px; border-bottom: 1px solid #4c4b45; color: var(--acid); font: 750 10px/1.2 ui-monospace, monospace; letter-spacing: .08em; }
  .terminal pre { margin: 0; padding: clamp(20px, 3vw, 40px); overflow-x: auto; font: 600 13px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .prompt { color: var(--orange); }
  .output { color: #aaa79e; }
  .terminal-note { margin: 0; padding: 14px 18px; border-top: 1px solid #4c4b45; color: #aaa79e; font: 600 10px/1.45 ui-monospace, monospace; }

  .boundary { min-height: 720px; position: relative; display: grid; place-items: center; overflow: hidden; color: white; background: var(--blue); }
  .boundary-grid { position: absolute; inset: 0; opacity: .22; background-image: linear-gradient(rgba(255,255,255,.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.3) 1px, transparent 1px); background-size: 42px 42px; transform: perspective(700px) rotateX(58deg) scale(1.4) translateY(18%); transform-origin: center bottom; }
  .boundary-copy { position: relative; max-width: 1050px; padding: clamp(32px, 5vw, 72px); border: 2px solid white; background: color-mix(in srgb, var(--blue) 88%, black); box-shadow: 12px 12px 0 var(--ink); }
  .boundary-copy > p { max-width: 820px; }
  .boundary-facts { display: grid; grid-template-columns: repeat(4, 1fr); margin: 48px 0 28px; border: 1.5px solid white; }
  .boundary-facts p { margin: 0; padding: 18px; display: grid; gap: 8px; }
  .boundary-facts p + p { border-left: 1.5px solid white; }
  .boundary-facts span { font: 700 10px/1 ui-monospace, monospace; letter-spacing: .08em; color: var(--acid); }
  .boundary-facts strong { font-size: 16px; }
  .fine-print { margin: 0; max-width: 760px !important; color: rgba(255,255,255,.72); font: 600 12px/1.55 ui-monospace, monospace !important; }

  .status { background: var(--paper-bright); }
  .status-columns { display: grid; grid-template-columns: 1fr 1fr; margin-top: 68px; border: var(--rule); }
  .status-card { padding: clamp(28px, 4vw, 56px); }
  .status-card + .status-card { border-left: var(--rule); }
  .status-card.current { background: var(--paper); }
  .status-card.next { background: white; }
  .status-label { display: flex; align-items: center; gap: 10px; margin-bottom: 34px; }
  .status-label span { width: 11px; height: 11px; border-radius: 50%; background: var(--blue); }
  .next .status-label span { background: var(--orange); }
  .status-card ul { margin: 0; padding: 0; list-style: none; }
  .status-card li { position: relative; padding: 15px 0 15px 28px; border-top: 1px solid #b7b2a7; font-size: 17px; line-height: 1.35; }
  .status-card li::before { content: "✓"; position: absolute; left: 0; font-weight: 900; color: var(--blue); }
  .status-card.next li::before { content: "→"; color: var(--orange); }
  .not-this { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 22px; }
  .not-this strong { margin-right: 8px; font: 850 12px/1 monospace; text-transform: uppercase; }
