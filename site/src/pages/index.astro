  .story-stage[data-story-layout="vertical"] .event-icon { grid-row: 1 / span 4; }
  .story-stage[data-story-layout="vertical"] .event-number { margin-top: 0; }
  .story-stage[data-story-layout="vertical"] .event-copy h3, .story-stage[data-story-layout="vertical"] .event-copy > p, .story-stage[data-story-layout="vertical"] .event-copy ul { grid-column: 2; }
  .story-stage[data-story-layout="vertical"] .event-cost { flex-direction: column; justify-content: center; border-top: 0; border-left: var(--rule); }
