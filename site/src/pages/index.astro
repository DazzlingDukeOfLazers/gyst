  .network-arrow b { font: 950 24px/1 ui-monospace, monospace; }
  .team-network figcaption { grid-column: 1 / -1; padding-top: 18px; border-top: 1.5px solid var(--ink); color: var(--muted); font: 650 11px/1.4 ui-monospace, monospace; text-align: center; }

  .story-stage { padding: clamp(28px, 4vw, 64px) clamp(20px, 4vw, 64px) clamp(72px, 8vw, 120px); color: white; background: var(--ink); }
  .story-overview { position: sticky; top: 76px; z-index: 30; border: 2px solid white; background: var(--ink); box-shadow: 0 12px 24px rgba(0,0,0,.38); }
  .overview-title { min-height: 50px; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid #69675f; }
