  .score > span { font: 850 11px/1.2 ui-monospace, monospace; text-transform: uppercase; }
  .score > strong { display: block; margin: 14px 0 8px; font-size: clamp(42px, 5vw, 72px); line-height: .9; letter-spacing: -.06em; }
  .score p { margin: 0; font-size: 16px; }
