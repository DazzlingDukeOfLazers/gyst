  .story-stage[data-story-layout="vertical"] .event-card { min-height: 0; grid-template-columns: 210px 1fr 150px; grid-template-rows: auto; align-items: stretch; }
  .story-stage[data-story-layout="vertical"] .event-meta { grid-template-columns: auto auto 1fr; align-content: start; border-right: var(--rule); border-bottom: 0; }
  .story-stage[data-story-layout="vertical"] .event-meta p { grid-column: 1 / -1; margin-top: 6px; }
