    <script>
      import { createCardHoverSync } from '../scripts/project-pulse.js';

      const stage = document.querySelector('.story-stage');
      const directionReadout = document.querySelector('.direction-readout');
      const directionButtons = document.querySelectorAll('[data-timeline-button]');
      const eventTrack = document.querySelector('.event-track');
      const eventCards = [...document.querySelectorAll('.event-card')];
      const scrollStatus = document.querySelector('[data-scroll-status]');

      const workdays = [];
      const cursor = new Date();
      cursor.setHours(12, 0, 0, 0);
      while (workdays.length < 16) {
        if (cursor.getDay() !== 0 && cursor.getDay() !== 6) workdays.push(new Date(cursor));
        cursor.setDate(cursor.getDate() + 1);
      }
      const dateFormat = new Intl.DateTimeFormat('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      });
      document.querySelectorAll('[data-workday-label]').forEach((label) => {
        const index = Number(label.getAttribute('data-workday-label'));
        const date = workdays[index];
        if (!(label instanceof HTMLTimeElement) || !date) return;
        label.dateTime = date.toISOString().slice(0, 10);
        label.textContent = dateFormat.format(date);
      });

      const setTimelineDirection = (direction) => {
        if (!(stage instanceof HTMLElement)) return;
        stage.dataset.storyLayout = direction || 'horizontal';
        directionButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) {
            button.setAttribute('aria-pressed', String(button.dataset.timelineButton === direction));
          }
        });
        if (directionReadout) {
          directionReadout.textContent = direction === 'vertical'
            ? 'TIME FLOWS TOP ↓ BOTTOM'
            : 'TIME FLOWS LEFT → RIGHT';
        }
      };

      const clearDayFocus = () => {
        if (!(stage instanceof HTMLElement)) return;
        stage.classList.remove('has-day-focus');
        stage.querySelectorAll('[data-day-index]').forEach((item) => {
          item.classList.remove('is-focused', 'is-muted');
        });
      };

      const focusDay = (day) => {
        if (!(stage instanceof HTMLElement) || day === null) return;
        stage.classList.add('has-day-focus');
        stage.querySelectorAll('[data-day-index]').forEach((item) => {
          const matches = item.getAttribute('data-day-index') === day;
          item.classList.toggle('is-focused', matches);
          item.classList.toggle('is-muted', !matches);
        });
      };

      let dayFocusClearTimer;
      let cardHoverSync;
      const cancelDayFocusClear = () => window.clearTimeout(dayFocusClearTimer);
      const scheduleDayFocusClear = () => {
        cancelDayFocusClear();
        dayFocusClearTimer = window.setTimeout(() => {
          const trackedCardDay = cardHoverSync?.getActiveDay();
          const hoveredItem = stage?.querySelector('[data-day-index]:hover');
          const focusedItem = document.activeElement?.closest?.('[data-day-index]');
          if (trackedCardDay !== null && trackedCardDay !== undefined) {
            focusDay(trackedCardDay);
            return;
          }
          const activeItem = hoveredItem || focusedItem;
          if (activeItem) {
            focusDay(activeItem.getAttribute('data-day-index'));
            return;
          }
          clearDayFocus();
        }, 220);
      };

      stage?.querySelectorAll('[data-day-index]').forEach((item) => {
        const day = item.getAttribute('data-day-index');
        item.addEventListener('pointerenter', () => {
          cancelDayFocusClear();
          focusDay(day);
        });
        item.addEventListener('pointerleave', scheduleDayFocusClear);
        item.addEventListener('focus', () => {
          cancelDayFocusClear();
          focusDay(day);
        });
        item.addEventListener('blur', scheduleDayFocusClear);
      });

      const centerEventCard = (day) => {
        if (!(stage instanceof HTMLElement) || !(eventTrack instanceof HTMLElement) || day === null) return;
        const card = eventCards.find((candidate) => candidate.getAttribute('data-day-index') === day);
        if (!(card instanceof HTMLElement)) return;

        const cardBounds = card.getBoundingClientRect();
        if (stage.dataset.storyLayout === 'vertical') {
          const overviewBounds = stage.querySelector('.story-overview')?.getBoundingClientRect();
          const visibleTop = Math.max(0, overviewBounds?.bottom || 0) + 12;
          const isShown = cardBounds.top >= visibleTop && cardBounds.bottom <= window.innerHeight - 12;
          if (!isShown) card.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' });
          return;
        }

        const trackBounds = eventTrack.getBoundingClientRect();
        const visibleRight = trackBounds.right - 76;
        const isShown = cardBounds.left >= trackBounds.left && cardBounds.right <= visibleRight;
        if (isShown) return;
        const centeredLeft = card.offsetLeft - (eventTrack.clientWidth - card.offsetWidth) / 2;
        eventTrack.scrollTo({ left: centeredLeft, behavior: 'smooth' });
      };

      let cardRevealTimer;
      const cancelCardReveal = () => window.clearTimeout(cardRevealTimer);
      document.querySelectorAll('.gantt-days button').forEach((button) => {
        button.addEventListener('pointerenter', () => {
          const day = button.getAttribute('data-day-index');
          cancelCardReveal();
          cardRevealTimer = window.setTimeout(() => {
            if (button.matches(':hover')) centerEventCard(day);
          }, 140);
        });
        button.addEventListener('pointerleave', cancelCardReveal);
        button.addEventListener('focus', () => centerEventCard(button.getAttribute('data-day-index')));
        button.addEventListener('click', () => {
          const day = button.getAttribute('data-day-index');
          const card = eventCards.find((candidate) => candidate.getAttribute('data-day-index') === day);
          card?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
      });

      if (eventTrack instanceof HTMLElement) {
        cardHoverSync = createCardHoverSync({
          eventTrack,
          resolveDayAtPoint: (x, y) => {
            const pointedElement = document.elementFromPoint(x, y);
            const card = pointedElement?.closest('.event-card[data-day-index]');
            return card && eventTrack.contains(card) ? card.getAttribute('data-day-index') : null;
          },
          onDayChange: focusDay,
        });
      }

      const updateScrollStatus = () => {
        if (!(eventTrack instanceof HTMLElement) || !scrollStatus || eventCards.length === 0) return;
        const trackBounds = eventTrack.getBoundingClientRect();
        const trackCenter = trackBounds.left + trackBounds.width / 2;
        const current = eventCards.reduce((best, card, index) => {
          const cardBounds = card.getBoundingClientRect();
          const distance = Math.abs(cardBounds.left + cardBounds.width / 2 - trackCenter);
          return distance < best.distance ? { index, distance } : best;
        }, { index: 0, distance: Number.POSITIVE_INFINITY });
        scrollStatus.textContent = `${current.index + 1} / ${eventCards.length}`;
      };

      document.querySelectorAll('[data-scroll-events]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(eventTrack instanceof HTMLElement)) return;
          const direction = button.getAttribute('data-scroll-events') === 'previous' ? -1 : 1;
          eventTrack.scrollBy({ left: direction * eventTrack.clientWidth * 0.76, behavior: 'smooth' });
        });
      });

      eventTrack?.addEventListener('scroll', () => requestAnimationFrame(updateScrollStatus), { passive: true });

      directionButtons.forEach((button) => {
        button.addEventListener('click', () => setTimelineDirection(button.getAttribute('data-timeline-button')));
      });

      if (window.matchMedia('(max-width: 720px)').matches) setTimelineDirection('vertical');
      updateScrollStatus();
    </script>
  </body>
</html>

