---
const githubUrl = 'https://github.com/DazzlingDukeOfLazers/gyst';
const productUrl = `${githubUrl}/blob/main/docs/product.md`;
const architectureUrl = `${githubUrl}/blob/main/docs/architecture.md`;

const reasons = [
  {
    number: '01',
    title: 'Find the authority',
    body: 'See the repository, folder, version, and observation behind an artifact—not merely the nearest copy with “final” in its name.',
    tag: 'WHERE IS THE REAL ONE?',
    icon: '/icons/document-search.svg',
    iconAlt: 'Document search',
  },
  {
    number: '02',
    title: 'Explain the change',
    body: 'Connect working files to Git history, preserve what was observed, and show the evidence behind every derived relationship.',
    tag: 'WHAT ACTUALLY MOVED?',
    icon: '/icons/change-history.svg',
    iconAlt: 'Revision history',
  },
  {
    number: '03',
    title: 'Prepare the handoff',
    body: 'Build toward release manifests that pin exact sources, generated outputs, tool versions, approvals, and manufacturing feedback.',
    tag: 'WHAT DID WE SHIP?',
    icon: '/icons/release-checklist.svg',
    iconAlt: 'Release checklist',
  },
  {
    number: '04',
    title: 'Keep the boundary',
    body: 'Run locally. Control content access and egress by policy. Core operation will never require a Gyst-hosted account or cloud.',
    tag: 'WHERE DOES IT RUN?',
    icon: '/icons/air-gap.svg',
    iconAlt: 'Air-gapped systems',
  },
];

const timelineDays = Array.from({ length: 10 }, (_, index) => index);

const ganttRows = [
  { name: 'ALICE', color: 'alice', active: [0, 2, 6] },
  { name: 'BOB', color: 'bob', active: [1, 3, 8] },
  { name: 'CHARLIE', color: 'charlie', active: [5, 7, 9] },
  { name: 'GYST', color: 'gyst', active: timelineDays },
  { name: 'PLM', color: 'plm', active: [9] },
];

const costPoints = [
  ['48', '79'], ['88', '65'], ['128', '61'], ['168', '28'], ['208', '28'],
  ['248', '28'], ['288', '28'], ['328', '28'], ['368', '10'], ['412', '10'],
];

const storyEvents = [
  {
    dayIndex: 0, actor: 'Alice', role: 'Electrical', color: 'alice',
    title: 'The schematic becomes a source',
    body: 'Alice commits the power and sensor schematic on feature/power. Gyst records the file, commit, author, and observation time without deciding that the branch is released.',
    icon: '/icons/schematic.svg', iconAlt: 'Electrical schematic',
    changes: ['SCH rev A', 'feature/power', '12 components'], spend: '$480',
  },
  {
    dayIndex: 1, actor: 'Bob', role: 'Mechanical + PCB', color: 'bob',
    title: 'The board takes physical shape',
    body: 'Bob routes PCB rev A and pushes it to feature/layout. Gyst links it to Alice’s schematic through declared project context and Git evidence.',
    icon: '/icons/circuit-board.svg', iconAlt: 'Circuit board',
    changes: ['PCB rev A', 'feature/layout', '2-layer quote'], spend: '$760',
  },
  {
    dayIndex: 2, actor: 'Alice', role: 'Electrical', color: 'alice',
    title: 'A fastener changes the design',
    body: 'Alice changes the mounting hardware from M4 to M3 and reduces quantity from eight to six. The old M4 note still exists in a PDF, so Gyst marks a conflict instead of hiding it.',
    icon: '/icons/machine-screw.svg', iconAlt: 'Machine screw',
    changes: ['M4 → M3', 'QTY 8 → 6', 'Conflict found'], spend: '$840',
  },
  {
    dayIndex: 3, actor: 'Bob', role: 'Mechanical + PCB', color: 'bob',
    title: 'The enclosure follows the hardware',
    body: 'Bob moves the standoffs, exports enclosure-rev-b.dxf to the network release folder, and updates the sheet-metal quote. Gyst observes both Git and the shared folder.',
    icon: '/icons/cad-drawing.svg', iconAlt: 'CAD drawing',
    changes: ['DXF rev B', 'Standoffs moved', 'Quote +$700'], spend: '$1,540',
  },
  {
    dayIndex: 4, actor: 'Gyst', role: 'Observer', color: 'gyst',
    title: 'The evidence becomes one explainable view',
    body: 'Gyst connects schematic, PCB, BOM, DXF, commits, and observed copies. It reports why they appear related, where authority is declared, and which M4 reference remains unresolved.',
    icon: '/icons/bill-of-materials.svg', iconAlt: 'Bill of materials',
    changes: ['5 artifacts linked', '1 ambiguity', '0 files moved'], spend: '$1,540',
  },
  {
    dayIndex: 5, actor: 'Charlie', role: 'Release owner', color: 'charlie',
    title: 'Charlie reviews the evidence',
    body: 'Charlie compares both branches, the changed BOM rows, the DXF fingerprint, and the unresolved M4 note. The release pauses on one explainable conflict—not on a hunch.',
    icon: '/icons/change-history.svg', iconAlt: 'Revision record',
    changes: ['2 branches reviewed', '1 hold', 'Evidence cited'], spend: '$1,540',
  },
  {
    dayIndex: 6, actor: 'Alice', role: 'Electrical', color: 'alice',
    title: 'Alice closes the stale reference',
    body: 'Alice updates the assembly note to M3, commits the correction, and links the decision. Gyst can now explain why the BOM, drawing, and note agree.',
    icon: '/icons/machine-screw.svg', iconAlt: 'Corrected machine screw',
    changes: ['M4 note → M3', 'Decision linked', 'Conflict cleared'], spend: '$1,540',
  },
  {
    dayIndex: 7, actor: 'Charlie', role: 'Release owner', color: 'charlie',
    title: 'Charlie merges exact commits',
    body: 'Charlie merges feature/power and feature/layout after the evidence-backed review. The merge records what was accepted without turning Gyst itself into the approver.',
    icon: '/icons/merge.svg', iconAlt: 'Git branch merge',
    changes: ['2 branches merged', 'Review recorded', 'RC candidate'], spend: '$1,540',
  },
  {
    dayIndex: 8, actor: 'Bob', role: 'Mechanical + PCB', color: 'bob',
    title: 'The matched prototypes fit',
    body: 'The correct PCB and enclosure prototype arrive together. Bob verifies the M3 standoffs and enclosure fit while the evidence still points back to the exact released files.',
    icon: '/icons/circuit-board.svg', iconAlt: 'Matched circuit board prototype',
    changes: ['Fit confirmed', 'M3 verified', 'Prototype +$380'], spend: '$1,920',
  },
  {
    dayIndex: 9, actor: 'Charlie', role: 'Release owner', color: 'charlie',
    title: 'PLM receives a pinned release',
    body: 'Charlie publishes RC-0.3. The PLM tracks released parts and quantities; the Gyst manifest preserves the exact commits, fingerprints, tool versions, approvals, and source locations behind them.',
    icon: '/icons/release-checklist.svg', iconAlt: 'Approved release checklist',
    changes: ['RC-0.3', 'PLM updated', 'Evidence attached'], spend: '$1,920',
  },
];

const wrongPathEvents = [
  {
    dayIndex: 2, label: 'Wrong authority',
    title: 'The M4 file wins by filename',
    body: 'An old assembly PDF is treated as final. The PCB and enclosure are prepared around M4 hardware and the earlier outline.',
    cost: '+$0',
  },
  {
    dayIndex: 3, label: 'Doomed order',
    title: 'Prototype boards are ordered',
    body: 'The fabrication package contains the stale footprint and old enclosure geometry. Nothing in the folder name exposes the mismatch.',
    cost: '+$1,800',
  },
  {
    dayIndex: 4, label: 'False confidence',
    title: 'Rush 3D prints test the wrong shape',
    body: 'Expensive enclosure models arrive quickly, but they only prove that the obsolete board outline fits the obsolete enclosure.',
    cost: '+$950',
  },
  {
    dayIndex: 5, label: 'Stockout',
    title: 'A missing BOM line stops assembly',
    body: 'U7, a DFN-8 regulator, was never added to the released BOM and is now out of stock. SOT-23 and TSSOP alternatives are available but cannot use the existing footprint.',
    cost: '+$0 / time lost',
  },
  {
    dayIndex: 6, label: 'Order outruns decision',
    title: 'The alternate form factor is rushed first',
    body: 'A new-footprint PCB order starts before the prototype change order is approved. Purchasing, CAD, and fabrication now hold different instructions.',
    cost: '+$1,300',
  },
  {
    dayIndex: 7, label: 'Change-order chaos',
    title: 'The formal change lands behind the rush job',
    body: 'The approved ECO supersedes work already in motion. Scrap, rework, and another board-and-enclosure order push the fit answer beyond this timeline.',
    cost: '+$2,450',
  },
];

const currentCapabilities = [
  'Local-folder inventory and incremental scans',
  'Immutable observations and replayable projections',
  'Native Git commit observation and file reconciliation',
  'Reversible file-identity profiles with explanations',
  'Deletion records and conservative rename detection',
];

const nextCapabilities = [
  'Portable, human-readable audit report',
  'Offline Windows installation and signed updates',
  'KiCad, PDF, spreadsheet, and BOM extraction',
  'Inspectable release-candidate manifests',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Find authoritative engineering files, explain changes, and prepare trustworthy releases without moving work into someone else's cloud."
    />
    <meta name="theme-color" content="#f2eddf" />
    <meta property="og:title" content="Gyst — Self-hosted engineering file provenance" />
    <meta
      property="og:description"
      content="Find the right engineering file. Explain what changed. Prove what went into the release. No migration required."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Gyst — Self-hosted engineering file provenance</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the page</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Gyst home">
        <span class="wordmark-mark" aria-hidden="true">G</span>
        <span>GYST</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#why">Why</a>
        <a href="#how">How</a>
        <a href="#story">Story</a>
        <a href="#status">Status</a>
      </nav>
      <a class="header-link" href={githubUrl}>GitHub <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="live-dot" aria-hidden="true"></span> Free · open source · pre-alpha</p>
          <h1 id="hero-title">Find the right file.<br /><span>Prove the release.</span></h1>
          <p class="deck">
            Gyst watches the repositories and folders your engineering team already uses.
            It shows what changed, where each fact came from, and where it is not sure—without
            moving your work into somebody else’s cloud.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={githubUrl}>
              Inspect the prototype <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#how">See how it works <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-facts" aria-label="Project facts">
            <li>MIT licensed</li>
            <li>Read-only first</li>
            <li>Local by design</li>
          </ul>
        </div>

        <div class="artifact-stack" aria-label="Illustration of several conflicting engineering files">
          <div class="artifact-card artifact-card-back">
            <span class="file-kind">PDF</span>
            <strong>controller-FINAL.pdf</strong>
            <span class="artifact-meta">shared-drive / modified Tuesday</span>
          </div>
          <div class="artifact-card artifact-card-middle">
            <span class="file-kind">ZIP</span>
            <strong>FAB_USE_THIS_v3.zip</strong>
            <span class="artifact-meta">downloads / source unknown</span>
          </div>
          <div class="artifact-card artifact-card-front">
            <div class="card-topline">
              <span class="file-kind">PCB</span>
              <span class="confidence">? authority</span>
            </div>
            <strong>controller-final-v2.kicad_pcb</strong>
            <span class="artifact-meta">hardware/main · commit 2d41a90</span>
            <div class="evidence-line"><span></span> Evidence, not filename optimism.</div>
          </div>
          <div class="stamp" aria-hidden="true">WHICH<br />ONE?</div>
        </div>
      </section>

      <section class="recognition" aria-labelledby="recognition-title">
        <p class="section-index">THE PROBLEM / 00</p>
        <div>
          <h2 id="recognition-title">Someone knows where the real one is.</h2>
          <p>
            The release process should not depend on finding that person in chat. Engineering
            work is split across Git, CAD, network folders, PDFs, spreadsheets, exports, and
            the copy somebody renamed during a deadline. Gyst starts there.
          </p>
        </div>
        <p class="pull-quote">No migration.<br />No magical “single source of truth.”<br />Start with what exists.</p>
      </section>

      <section class="system" id="how" aria-labelledby="system-title">
        <div class="section-heading">
          <p class="section-index">WHAT IT IS / 01</p>
          <h2 id="system-title">Engineering observability.<br />Not another place to put everything.</h2>
          <p>
            Gyst separates what a source said from what the system concludes. That small
            distinction keeps a helpful guess from quietly becoming a manufacturing fact.
          </p>
        </div>

        <div class="flow" role="img" aria-label="Existing engineering sources flow into immutable observations and then evidence-backed answers">
          <div class="flow-column sources">
            <p class="flow-label">Sources stay put</p>
            <span>Git repositories</span>
            <span>Local folders</span>
            <span>CAD + PDFs</span>
            <span>BOM sheets</span>
          </div>
          <div class="flow-arrow" aria-hidden="true">→</div>
          <div class="flow-core">
            <p class="flow-label">Gyst observes</p>
            <strong>Immutable<br />evidence</strong>
            <div class="core-rings" aria-hidden="true"><i></i><i></i><i></i></div>
          </div>
          <div class="flow-arrow" aria-hidden="true">→</div>
          <div class="flow-column answers">
            <p class="flow-label">You can ask</p>
            <span>What is this?</span>
            <span>Where is authority?</span>
            <span>What changed?</span>
            <span>What needs attention?</span>
          </div>
        </div>

        <div class="principle-strip">
          <p><strong>OBSERVE</strong><span>Read sources without rearranging them.</span></p>
          <p><strong>EXPLAIN</strong><span>Cite the evidence behind every relationship.</span></p>
          <p><strong>REFUSE</strong><span>Say “ambiguous” when the evidence cannot decide.</span></p>
        </div>
      </section>

      <section class="reasons" id="why" aria-labelledby="reasons-title">
        <div class="section-heading compact">
          <p class="section-index">WHY USE IT / 02</p>
          <h2 id="reasons-title">Less archaeology.<br />More engineering.</h2>
        </div>
        <div class="reason-grid">
          {reasons.map((reason) => (
            <article class="reason-card">
              <div class="reason-top">
                <span>{reason.number}</span>
                <span>{reason.tag}</span>
              </div>
              <div class="reason-icon"><img src={reason.icon} alt={reason.iconAlt} /></div>
              <h3>{reason.title}</h3>
              <p>{reason.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="story" id="story" aria-labelledby="story-title">
        <div class="story-heading">
          <div>
            <p class="section-index">A REAL DEVELOPMENT JOURNEY / 03</p>
            <h2 id="story-title">One board.<br />Ten workdays.<br /><span>Every change explained.</span></h2>
          </div>
          <div class="story-intro">
            <p>
              Alice and Bob change the design. Charlie decides what merges. Gyst observes the
              evidence across Git and the network folder, then gives the PLM an exact released
              state instead of pretending every working file belongs there.
            </p>
            <div class="timeline-switch" role="group" aria-label="Timeline direction">
              <button type="button" data-timeline-button="horizontal" aria-pressed="true">
                <span aria-hidden="true">→</span> Horizontal time
              </button>
              <button type="button" data-timeline-button="vertical" aria-pressed="false">
                <span aria-hidden="true">↓</span> Vertical time
              </button>
            </div>
          </div>
        </div>

        <figure class="team-network">
          <div class="workstations">
            {[
              ['A', 'Alice', 'Electrical'],
              ['B', 'Bob', 'Mechanical + PCB'],
              ['C', 'Charlie', 'Release owner'],
            ].map(([initial, name, role]) => (
              <div class="person-node">
                <span class={`avatar avatar-${initial.toLowerCase()}`}>{initial}</span>
                <img src="/icons/developer-workstation.svg" alt="Developer workstation" />
                <p><strong>{name}</strong><span>{role}</span></p>
              </div>
            ))}
          </div>
          <div class="network-arrow"><span>PUSH / REVIEW</span><b aria-hidden="true">→</b></div>
          <div class="system-node server-node">
            <img src="/icons/file-server.svg" alt="Git and network file server" />
            <p><strong>Git + file server</strong><span>Authoritative sources stay here</span></p>
          </div>
          <div class="network-arrow"><span>OBSERVE</span><b aria-hidden="true">→</b></div>
          <div class="system-node gyst-node">
            <span class="gyst-glyph" aria-hidden="true">G</span>
            <p><strong>Gyst</strong><span>Evidence + relationships</span></p>
          </div>
          <div class="network-arrow"><span>RELEASE</span><b aria-hidden="true">→</b></div>
          <div class="system-node plm-node">
            <img src="/icons/release-checklist.svg" alt="PLM release record" />
            <p><strong>PLM</strong><span>Released parts + quantities</span></p>
          </div>
          <figcaption>Working systems remain authoritative. Gyst carries provenance between them.</figcaption>
        </figure>

        <div class="story-stage" data-story-layout="horizontal">
          <div class="story-overview">
            <div class="overview-title">
              <p><strong>PROJECT PULSE</strong><span>10 workdays starting today · weekends skipped</span></p>
              <span class="direction-readout" aria-live="polite">TIME FLOWS LEFT → RIGHT</span>
            </div>
            <div class="overview-grid">
              <div class="gantt-scroll">
                <div class="gantt" aria-label="Ten-workday activity summary">
                  <div class="gantt-row gantt-days">
                    <strong>WHO</strong>
                    {timelineDays.map((day) => (
                      <button type="button" data-day-index={day} aria-label={`Focus workday ${day + 1}`}>
                        <span>Day {day + 1}</span>
                        <time data-workday-label={day}>WORKDAY</time>
                      </button>
                    ))}
                  </div>
                  {ganttRows.map((row) => (
                    <div class:list={['gantt-row', row.color]}>
                      <strong><span aria-hidden="true"></span>{row.name}</strong>
                      {timelineDays.map((day) => (
                        <i class:list={{ on: row.active.includes(day) }} data-day-index={day} aria-hidden="true"></i>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
              <figure class="cost-chart">
                <figcaption><strong>COMMITTED SPEND</strong><span>$0 → $1,920</span></figcaption>
                <svg viewBox="0 0 420 112" role="img" aria-label="Illustrative cumulative project spend rising from zero to 1,920 dollars over ten workdays">
                  <path class="cost-area" d="M8 100 L48 79 L88 65 L128 61 L168 28 L208 28 L248 28 L288 28 L328 28 L368 10 L412 10 L412 104 L8 104 Z"></path>
                  <polyline points="8,100 48,79 88,65 128,61 168,28 208,28 248,28 288,28 328,28 368,10 412,10"></polyline>
                  {costPoints.map(([cx, cy], day) => <circle cx={cx} cy={cy} r="4" data-day-index={day}></circle>)}
                </svg>
              </figure>
            </div>
          </div>

          <div class="track-controls">
            <p><strong>SCROLL THE STORY</strong><span>Drag, swipe, use Shift + wheel, or use the arrows.</span></p>
            <div>
              <button type="button" data-scroll-events="previous" aria-label="Previous development event">←</button>
              <span data-scroll-status aria-live="polite">1 / 10</span>
              <button type="button" data-scroll-events="next" aria-label="Next development event">→</button>
            </div>
          </div>
          <div class="event-window">
            <div class="event-track" id="development-events" aria-label="Scrollable development story events" tabindex="0">
              {storyEvents.map((event, index) => (
                <article class:list={['event-card', event.color]} data-day-index={event.dayIndex} tabindex="0">
                  <div class="event-meta">
                    <time class="event-day" data-workday-label={event.dayIndex}>D{event.dayIndex + 1}</time>
                    <span class={`avatar avatar-${event.actor.toLowerCase()}`}>{event.actor === 'Gyst' ? 'G' : event.actor[0]}</span>
                    <p><strong>{event.actor}</strong><span>{event.role}</span></p>
                  </div>
                  <div class="event-copy">
                    <div class="event-icon"><img src={event.icon} alt={event.iconAlt} /></div>
                    <p class="event-number">EVENT {String(index + 1).padStart(2, '0')}</p>
                    <h3>{event.title}</h3>
                    <p>{event.body}</p>
                    <ul>{event.changes.map((change) => <li>{change}</li>)}</ul>
                  </div>
                  <div class="event-cost"><span>CUMULATIVE</span><strong>{event.spend}</strong></div>
                </article>
              ))}
            </div>
          </div>
          <p class="story-note">
            This is a representative workflow and cost trace, not a claim that every team uses
            these tools or spends these amounts. Hover or focus a date or event to follow the
            same workday through the overview and story.
          </p>

          <section class="versus" aria-labelledby="versus-title">
            <div class="versus-heading">
              <p class="section-index">THE SAME PROJECT WITHOUT PROVENANCE</p>
              <h3 id="versus-title">One wrong file.<br /><span>Six extra workdays.</span></h3>
              <p>
                The design still moves quickly. It simply moves in conflicting directions—and
                every rushed artifact makes the next correction more expensive.
              </p>
            </div>

            <div class="versus-scoreboard">
              <article class="score good">
                <span>Evidence path</span>
                <strong>$1,920</strong>
                <p>Enclosure fit known <time data-workday-label="8">workday 9</time></p>
              </article>
              <div class="versus-mark" aria-hidden="true">VS</div>
              <article class="score bad">
                <span>Wrong-file path</span>
                <strong>$8,420</strong>
                <p>Fit known <time data-workday-label="14">six workdays later</time></p>
              </article>
            </div>

            <div class="comparison-calendar" aria-label="Comparison of the evidence path and wrong-file path over ten workdays">
              <div class="comparison-row comparison-days">
                <strong>PATH</strong>
                {timelineDays.map((day) => <time data-workday-label={day} data-day-index={day}>D{day + 1}</time>)}
              </div>
              <div class="comparison-row evidence-row">
                <strong>WITH GYST</strong>
                {timelineDays.map((day) => <i class:list={{ active: day < 9, result: day === 8 }} data-day-index={day} aria-hidden="true"></i>)}
              </div>
              <div class="comparison-row wrong-row">
                <strong>WRONG FILE</strong>
                {timelineDays.map((day) => <i class:list={{ active: day >= 2, chaos: day >= 5 }} data-day-index={day} aria-hidden="true"></i>)}
              </div>
              <p class="beyond-window">+ 6 workdays to a trustworthy fit answer →</p>
            </div>

            <div class="failure-grid">
              {wrongPathEvents.map((event) => (
                <article class="failure-card" data-day-index={event.dayIndex} tabindex="0">
                  <div><time data-workday-label={event.dayIndex}>D{event.dayIndex + 1}</time><strong>{event.label}</strong></div>
                  <h4>{event.title}</h4>
                  <p>{event.body}</p>
                  <span>{event.cost}</span>
                </article>
              ))}
            </div>

            <div class="cost-consequence">
              <div>
                <p class="section-index">ILLUSTRATIVE EXTRA PROTOTYPE COST</p>
                <strong class="cost-delta">+$6,500</strong>
                <p>Before labor, lost attention, or the commercial cost of learning about fit six workdays late.</p>
              </div>
              <ul>
                <li><span>Doomed board run</span><strong>$1,800</strong></li>
                <li><span>Rush 3D-printed models</span><strong>$950</strong></li>
                <li><span>Rush alternate footprint</span><strong>$1,300</strong></li>
                <li><span>Superseded change order + scrap</span><strong>$850</strong></li>
                <li><span>Replacement boards + enclosure</span><strong>$1,600</strong></li>
              </ul>
            </div>
          </section>
        </div>
      </section>

      <section class="quickstart" aria-labelledby="quickstart-title">
        <div class="quickstart-copy">
          <p class="section-index">HOW TO USE IT / 04</p>
          <h2 id="quickstart-title">Point. Observe. Ask.</h2>
          <p>
            The current developer preview uses Go and PostgreSQL. Once built and connected to
            its database, the CLI can observe a folder and repository, show recent changes,
            and explain the provenance known for a file.
          </p>
          <ol>
            <li><span>1</span><div><strong>Point</strong><p>Choose only the roots Gyst is allowed to inspect.</p></div></li>
