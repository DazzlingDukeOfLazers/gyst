  .comparison-calendar { padding: 18px; overflow-x: auto; border: 1px solid #69675f; background: #242421; scrollbar-color: var(--orange) #33332f; }
  .comparison-row { min-width: 870px; display: grid; grid-template-columns: 110px repeat(10, minmax(52px, 1fr)); gap: 4px; }
